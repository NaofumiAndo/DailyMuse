# DailyMuse Configuration

# IMPORTANT: Copy this file to .env and fill in your own values!
# Never commit .env file with real values - it should remain LOCAL ONLY.

# === API KEYS ===

# Gemini API Key for AI image generation
# Get your API key from: https://aistudio.google.com/app/apikey
# Note: GEMINI_API_KEY is for server-side, VITE_GEMINI_API_KEY is for frontend
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# === PASSWORDS (REQUIRED) ===

# Admin Password for 4-Panel Comic Creator Panel (pages/Admin.tsx & pages/StoryAtlas.tsx)
# This password is REQUIRED and has no default fallback for security.
# NOTE: These passwords are only secure when running locally.
# Do NOT deploy the Creator panel to a public website.
VITE_ADMIN_PASSWORD=your_secure_admin_password_here

# Creator Password for Story List editing (pages/StoryList.tsx)
# This password is REQUIRED and has no default fallback for security.
VITE_CREATOR_PASSWORD=your_secure_creator_password_here

# === OPTIONAL SETTINGS ===

# API URL (optional, defaults to http://localhost:3001 during development)
# VITE_API_URL=http://localhost:3001
